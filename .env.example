# Required — your Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Required for uploads. On Vercel this is set automatically when you attach a
# Blob store to the project (Storage → Create → Blob). For local dev, copy the
# token from the Vercel dashboard into .env.local.
BLOB_READ_WRITE_TOKEN=

# Optional — sent as the polite mailto to Crossref/OpenAlex for reference checks.
CONTACT_EMAIL=

# Optional — protects the daily cleanup cron route.
CRON_SECRET=
